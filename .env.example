# 持久化数据目录（权限白名单、历史记录、session 等）
# 设为代码目录之外的固定路径，这样重新 git clone 部署时数据不会丢失
# 云端示例：DATA_DIR=/opt/survey-web-data
# 不填则默认使用代码目录下的 data/
DATA_DIR=

# Google Form 跳转关系推断（可选；未配置时使用以下默认值）
# 小于该有效回答量时不容忍任何分支外回答；达到后允许按下一项比例容忍少量脏数据。
BRANCH_ANOMALY_MIN_ANSWERS=20
BRANCH_MAX_LEAKAGE_RATE=0.05

# Dify API
DIFY_API_BASE=https://dify.web.moontontech.net/v1
# 数据标注模块
DIFY_AI_DETECT_KEY=app-xxxxxxxxxxxxxxxxxxxxxxx   # AI 作答识别（新建 Dify 应用）
DIFY_QUALITY_KEY=app-xxxxxxxxxxxxxxxxxxxxxxx     # 回答质量打标（已有 Dify 应用）
# 内容生成风险达到 60 分进入人工关注，达到 80 分默认勾选为高概率 AI 作答。
# AI 润色概率不参与违规判断。
ANNOTATE_AI_REVIEW_THRESHOLD=60
ANNOTATE_AI_HIGH_THRESHOLD=80
ANNOTATE_AI_BATCH_SIZE=10
ANNOTATE_QUALITY_BATCH_SIZE=15
ANNOTATE_AI_CONCURRENCY=3
ANNOTATE_QUALITY_CONCURRENCY=3
# 单次发给模型的查询字符预算；超长回答会据此自动缩小批次。
ANNOTATE_AI_MAX_QUERY_CHARS=45000
ANNOTATE_QUALITY_MAX_QUERY_CHARS=40000

# 问卷题型识别、方案规划、报告写作与报告追问：直连公司 LLM 分发服务。
LLM_API_BASE=https://llm.moontontech.net/v1
LLM_API_KEY=
# 题型识别：英语、印尼语等多语言问卷优先使用 Terra，千问作为容灾备选。
LLM_COLUMN_MODEL=gpt-5.6-terra
LLM_COLUMN_FALLBACK_MODELS=qwen3.7-plus
LLM_COLUMN_REASONING=medium
LLM_COLUMN_MAX_TOKENS=16000
# 普通问卷方案和跑数表章节大纲共用同一模型链，但使用各自独立的提示词与 schema。
LLM_PLANNER_MODEL=gpt-5.6-sol
LLM_PLANNER_FALLBACK_MODELS=claude-sonnet-5
LLM_PLANNER_REASONING=high
LLM_PLANNER_MAX_TOKENS=16000
# 大样本开放题：分批主题提取 → 跨批合并 → 回答分类。
LLM_THEME_EXTRACT_MODEL=claude-sonnet-5
LLM_THEME_EXTRACT_FALLBACK_MODELS=gpt-5.6-terra
LLM_THEME_EXTRACT_REASONING=medium
LLM_THEME_EXTRACT_MAX_TOKENS=16000
LLM_THEME_EXTRACT_CONCURRENCY=2
LLM_THEME_MERGE_MODEL=claude-sonnet-5
LLM_THEME_MERGE_FALLBACK_MODELS=gpt-5.6-sol
LLM_THEME_MERGE_REASONING=high
LLM_THEME_MERGE_MAX_TOKENS=16000
LLM_CLASSIFY_MODEL=gpt-5.6-terra
LLM_CLASSIFY_FALLBACK_MODELS=claude-sonnet-5
LLM_CLASSIFY_REASONING=medium
LLM_CLASSIFY_MAX_TOKENS=32000
LLM_CLASSIFY_CONCURRENCY=2
LLM_REPORT_MODEL=claude-sonnet-5
# 可选：主模型持续不可用时按顺序切换；多个模型用逗号分隔。
LLM_REPORT_FALLBACK_MODELS=gpt-5.6-sol
LLM_REPORT_MAX_TOKENS=16000
# 报告追问统一使用同一模型链，不再区分普通/大样本/跑数表 Dify Analyst。
LLM_QA_MODEL=claude-sonnet-5
LLM_QA_FALLBACK_MODELS=gpt-5.6-sol
LLM_QA_REASONING=medium
LLM_QA_MAX_TOKENS=16000
LLM_REPORT_MAX_ATTEMPTS=3
LLM_STREAM_HEARTBEAT_SECONDS=20

# 访谈报告（复用上方 LLM_API_BASE / LLM_API_KEY）
INTERVIEW_EXTRACT_MODEL=gpt-5.6-terra
INTERVIEW_REPORT_MODEL=gpt-5.6-sol
INTERVIEW_AUDIT_MODEL=gpt-5.6-terra
INTERVIEW_REPAIR_MODEL=gpt-5.6-sol
INTERVIEW_FALLBACK_MODELS=gpt-5.5
INTERVIEW_EXTRACT_REASONING=medium
INTERVIEW_REPORT_REASONING=high
INTERVIEW_AUDIT_REASONING=medium
INTERVIEW_REPAIR_REASONING=high
INTERVIEW_EXTRACT_MAX_TOKENS=32000
INTERVIEW_MAX_UPLOAD_BYTES=52428800
INTERVIEW_MAX_INPUT_CHARS=700000
INTERVIEW_MAX_REPAIR_ROUNDS=2
LLM_CONNECT_TIMEOUT=15
LLM_READ_TIMEOUT=900

# 帖子评论舆情分析（单 Workflow 应用，mode 路由 5 个分支；配置见 docs/comment_analysis_dify.md）
DIFY_COMMENT_ANALYSIS_KEY=app-xxxxxxxxxxxxxxxxxxxxxxx

# 飞书导出（OAuth 网页登录）。配置步骤见 docs/feishu_oauth.md
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE=https://open.feishu.cn/open-apis
FEISHU_REDIRECT_URI=https://<部署域名>/api/feishu/callback
# 留空使用飞书开放平台里为应用开通的默认权限。
# 不要只填 drive:file:upload；导出 docx 还需要“查看、创建云文档导入任务”等权限。
FEISHU_SCOPE=

# 飞书整站登录（邮箱白名单）
FEISHU_LOGIN_REQUIRED=true
FEISHU_ALLOWED_EMAILS=user1@example.com,user2@example.com
FEISHU_SESSION_DAYS=7
